# docker compose reads this file as .env
DDB_PORT=5142
# exactly 128 characters, or leave empty to generate on first start
DDB_MAIN_TOKEN=
DENIS_BOOTSTRAP_GROUP=denis
DENIS_BOOTSTRAP_GROUP_PASSWORD=change-me
DENIS_MAX_CONNECTIONS=256
DENIS_MAX_CONNECTIONS_PER_IP=64
DENIS_CLIENT_IDLE_TIMEOUT_MS=0
DENIS_PERSIST_FLUSH_INTERVAL_MS=1000
DENIS_LANGUAGE=en
DENIS_LOG_LEVEL=info
DENIS_VERSION=0.3.1
