# docker compose reads this file as .env (cp .env.example .env)
DDB_PORT=5142
# 127.0.0.1 = reachable from this host only; 0.0.0.0 = from the network
DENIS_PUBLISH=127.0.0.1
# ADMIN commands (Denis Cloud, provisioning): at least 32 characters (128 recommended),
# or leave empty to generate one on first start (written to /data/denis.properties)
DDB_MAIN_TOKEN=
# login group created on first start; an existing group of that name becomes an admin group
DENIS_BOOTSTRAP_GROUP=admin
DENIS_BOOTSTRAP_GROUP_PASSWORD=change-me-to-something-long
# always | everysec | no
DENIS_FSYNC=everysec
# e.g. 256mb; 0 = unlimited
DENIS_MAX_MEMORY=0
# automatic backups into the volume (data/backups); 0 = off
DENIS_BACKUP_INTERVAL_MINUTES=0
DENIS_BACKUP_RETENTION=7
DENIS_MAX_CLIENTS=10000
DENIS_MAX_CONNECTIONS_PER_IP=64
# seconds; 0 = never disconnect idle clients
DENIS_CLIENT_TIMEOUT_SECONDS=0
DENIS_LOG_LEVEL=info
# image label / HELLO version of a local build
DENIS_VERSION=0.7.0
