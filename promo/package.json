{
  "name": "denis-promo",
  "version": "0.1.0",
  "private": true,
  "description": "20-second promo video for Denis (Remotion). Renders docs/assets/denis-promo.mp4 and its poster.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Promo ../docs/assets/denis-promo-poster.png --frame=385",
    "render": "remotion render src/index.ts Promo ../docs/assets/denis-promo.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
