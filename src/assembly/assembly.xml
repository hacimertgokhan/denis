<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <!--
      Release bundle: the server jar, launchers, installers and service units.
      No configuration or data is shipped; `denis init` (run by the installers)
      writes denis.properties and the first admin group.
    -->
    <id>project-bundle</id>
    <formats>
        <format>zip</format>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}</directory>
            <includes>
                <include>${project.build.finalName}.jar</include>
            </includes>
            <outputDirectory>/</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${basedir}</directory>
            <includes>
                <include>bin/denis</include>
                <include>install.sh</include>
            </includes>
            <outputDirectory>/</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${basedir}</directory>
            <includes>
                <include>bin/denis.bat</include>
                <include>install.bat</include>
            </includes>
            <outputDirectory>/</outputDirectory>
            <lineEnding>dos</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${basedir}</directory>
            <includes>
                <include>install.ps1</include>
                <include>service/**</include>
                <include>docs/**</include>
                <include>README.md</include>
                <include>CHANGELOG.md</include>
                <include>LICENSE</include>
            </includes>
            <outputDirectory>/</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
