# --- Platform ---------------------------------------------------------------
# Public URL of this deployment (no trailing slash). Used by better-auth for
# callbacks/cookies and in the connection snippets shown to users.
NEXT_PUBLIC_APP_URL=https://denis.hacimertgokhan.com

# PostgreSQL for users, sessions, databases, API keys and usage samples.
DATABASE_URL=postgres://denis:change-me@localhost:5432/denis_platform

# --- Secrets ------------------------------------------------------------------
# Generate each one with:  openssl rand -base64 48
# better-auth: signs session cookies.
BETTER_AUTH_SECRET=change-me-better-auth-secret
# JWT access tokens issued to API keys (short lived).
JWT_SECRET=change-me-jwt-secret
# JWT refresh tokens (long lived); must differ from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
# Access token lifetime in seconds (default 900 = 15 min) and refresh token lifetime (default 30 days).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Optional social login (leave empty to disable).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Denis server -------------------------------------------------------------
# The platform is the only client of the Denis server; users never get these.
DENIS_HOST=127.0.0.1
DENIS_PORT=5142
# Login group the platform uses (create it with DENIS_BOOTSTRAP_GROUP on the server).
DENIS_GROUP=platform
DENIS_PASSWORD=change-me-platform-group-password
# The server's 128-character ddb-main-token / DDB_MAIN_TOKEN: authenticates ADMIN commands.
DENIS_MAIN_TOKEN=

# --- Plan limits (free tier) ---------------------------------------------------
PLAN_MAX_DATABASES=3
# Per database: stored data (characters of keys + values, cache and persisted each) and key count.
PLAN_DB_MAX_BYTES=10485760
PLAN_DB_MAX_KEYS=50000
# Per database: commands per UTC day through the console, the API and MCP.
PLAN_DB_OPS_PER_DAY=100000
# Per API key: requests per minute.
PLAN_API_RATE_PER_MINUTE=600

# System administrators (comma-separated emails). They see /admin and the admin API.
PLATFORM_ADMINS=hacimertgokhan@gmail.com

# Legal identity shown on /privacy, /terms and /security (the data controller).
LEGAL_ENTITY=Hacı Mert Gökhan
LEGAL_CONTACT_EMAIL=hacimertgokhan@gmail.com
LEGAL_ADDRESS=

# Outgoing mail for password resets. Unset: reset links are printed to the server log.
SMTP_URL=
MAIL_FROM=Denis Cloud <no-reply@denis.hacimertgokhan.com>

# Cloudflare Turnstile (optional bot check on sign-up and password reset; honeypot + timing always run).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
